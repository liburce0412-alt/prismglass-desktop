diff --git a/tools/TestDiscard.cs b/tools/TestDiscard.cs
new file mode 100644
--- /dev/null
+++ b/tools/TestDiscard.cs
@@ -0,0 +1,50 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using System.Windows;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using Pegline;
+
+// Only generated images and isolated settings are used. Never restore personal pins.
+class TestDiscard
+{
+    static void Check(bool value, string name) { if (!value) throw new Exception(name); Console.WriteLine("PASS " + name); }
+    static string Image(string dir, string name)
+    {
+        string path = Path.Combine(dir, name);
+        var image = BitmapSource.Create(2, 2, 96, 96, PixelFormats.Bgra32, null,
+            new byte[] { 80,150,200,255,80,150,200,255,80,150,200,255,80,150,200,255 }, 8);
+        var png = new PngBitmapEncoder(); png.Frames.Add(BitmapFrame.Create(image));
+        using (var file = File.Create(path)) png.Save(file);
+        // A disposable fixture must not inherit EFS from its temporary directory.
+        if ((File.GetAttributes(path) & FileAttributes.Encrypted) != 0) File.Decrypt(path);
+        return path;
+    }
+    [STAThread] static void Main()
+    {
+        string dir = Path.Combine(Path.GetTempPath(), "PrismGlass-Discard-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(dir);
+        var flags = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+        typeof(Settings).GetField("Dir", flags).SetValue(null, dir);
+        typeof(Settings).GetField("file", flags).SetValue(null, Path.Combine(dir,"settings.ini"));
+        typeof(Settings).GetField("peggedFile", flags).SetValue(null, Path.Combine(dir,"pegged.txt"));
+        typeof(Settings).GetField("values", flags).SetValue(null, new Dictionary<string,string>{{"soundOff","1"}});
+        var line = new Line();
+        string deleted = Image(dir,"delete-original.png");
+        Guid id = line.Hang(deleted, true);
+        Check(id != Guid.Empty && !line.IsInInbox(id),"fixture is an external screenshot");
+        line.Discard(id);
+        Check(!File.Exists(deleted),"cross deletes external screenshot to Recycle Bin");
+        Check(line.Find(id).Falling && Settings.Pegged.Length == 0,"deleted screenshot leaves saved pins");
+        string kept = Image(dir,"keep-original.png");
+        Guid keptId = line.Hang(kept,true); line.Drop(keptId,true);
+        Check(File.Exists(kept),"take-down keeps original file");
+        string missing = Image(dir,"already-missing.png");
+        Guid missingId = line.Hang(missing,true); File.Delete(missing); line.Discard(missingId);
+        Check(line.Find(missingId).Falling,"already deleted screenshot dismisses cleanly");
+        Check(Settings.Dir == dir && File.Exists(Path.Combine(dir,"pegged.txt")),"all persistence is isolated");
+        Console.WriteLine("Fixture: " + dir);
+    }
+}

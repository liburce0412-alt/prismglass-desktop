+        // WPF maps the screen point through slide, swing, hover zoom and DPI.
+        // An untransformed rectangle misses the visibly rotated close corner.
+        public bool ContainsScreenPoint(Point screenPoint)
+        {
+            if (!IsVisible || Opacity <= 0.01) return false;
+            var point = frameHost.PointFromScreen(screenPoint);
+            return new Rect(0, 0, frameHost.ActualWidth, frameHost.ActualHeight).Contains(point);
+        }
+
         public bool InCross(Point p)
         {
             return p.X >= 0 && p.Y >= 0 && p.X < 26 && p.Y < 26;

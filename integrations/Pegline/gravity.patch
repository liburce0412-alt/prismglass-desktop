 | `CardView.cs` | 一张图：相框、夹子、摆动、微风 | `PeggedView.swift` |
+| `RopePhysics.cs` | 固定两端的受力绳与照片摆动 | PrismGlass 扩展 |
 | `Gestures.cs` | 单击、长按、拖拽、右键菜单、拖拽预览 | `GrabArea.swift` |
 | `Line.cs` | 挂着什么、每张图能做什么、持久化 | `Line.swift`、`Markup.swift` |
 | `Watchers.cs` | 监听 Screenshots 文件夹、接管剪贴板截图、全局快捷键 | `ScreenshotWatcher.swift`、`Inbox.swift`、`HotKey.swift` |
diff --git a/src/RopePhysics.cs b/src/RopePhysics.cs
new file mode 100644
--- /dev/null
+++ b/src/RopePhysics.cs
@@ -0,0 +1,97 @@
+using System;
+using System.Collections.Generic;
+
+namespace Pegline
+{
+    struct RopeLoad
+    {
+        public double Position, Mass;
+        public RopeLoad(double position, double mass) { Position = position; Mass = mass; }
+    }
+
+    // A tensioned string with fixed ends and distributed gravity. Photo loads
+    // act at their clips; small integration steps keep fast drags stable.
+    sealed class RopePhysics
+    {
+        public const int Segments = 48;
+        readonly double[] y = new double[Segments + 1];
+        readonly double[] velocity = new double[Segments + 1];
+        readonly double[] force = new double[Segments + 1];
+        double accumulator;
+        public RopePhysics()
+        {
+            for (int i = 0; i <= Segments; i++)
+            {
+                double u = (double)i / Segments;
+                y[i] = 4 * 16 * u * (1 - u);
+            }
+        }
+        public static double Mass(double width, double height)
+        {
+            return Math.Max(0.25, Math.Min(1.5, width * height / 10000.0));
+        }
+        public double Sample(double position)
+        {
+            double node = Math.Max(0, Math.Min(1, position)) * Segments;
+            int left = Math.Min(Segments - 1, (int)node);
+            return y[left] + (y[left + 1] - y[left]) * (node - left);
+        }
+        public double MaxSpeed
+        {
+            get { double max = 0; foreach (double v in velocity) max = Math.Max(max, Math.Abs(v)); return max; }
+        }
+        public void Step(double elapsed, IList<RopeLoad> loads)
+        {
+            double total = 0;
+            foreach (var load in loads) total += Math.Max(0, load.Mass);
+            // Increasing tension bounds the sag of a full line without clipping it.
+            double tension = 8 + Math.Min(20, total) * 1.2;
+            for (int i = 0; i <= Segments; i++) force[i] = 128 * tension;
+            foreach (var load in loads)
+            {
+                double node = Math.Max(0, Math.Min(1, load.Position)) * Segments;
+                int left = Math.Min(Segments - 1, (int)node);
+                double fraction = node - left, weight = 500 * Math.Max(0, Math.Min(1.5, load.Mass)) * Segments;
+                force[left] += weight * (1 - fraction);
+                force[left + 1] += weight * fraction;
+            }
+            const double h = 1.0 / 480;
+            accumulator += Math.Max(0, Math.Min(0.05, elapsed));
+            while (accumulator >= h)
+            {
+                for (int i = 1; i < Segments; i++)
+                    velocity[i] += (tension * Segments * Segments * (y[i - 1] - 2 * y[i] + y[i + 1]) + force[i] - 7 * velocity[i]) * h;
+                for (int i = 1; i < Segments; i++) y[i] += velocity[i] * h;
+                accumulator -= h;
+            }
+        }
+    }
+
+    // A pendulum driven by its moving attachment point. Angle and velocity are
+    // retained on release, so a drag never restarts a canned animation.
+    sealed class PhotoPendulum
+    {
+        double angle, angularVelocity, lastX, lastY, vx, vy;
+        bool initialized;
+        public double Degrees { get { return angle * 180 / Math.PI; } }
+        public void Step(double dt, double x, double y, double length, double mass)
+        {
+            if (dt <= 0) return;
+            if (!initialized) { lastX = x; lastY = y; initialized = true; return; }
+            double nextVx = (x - lastX) / dt, nextVy = (y - lastY) / dt;
+            double ax = Math.Max(-4500, Math.Min(4500, (nextVx - vx) / dt));
+            double ay = Math.Max(-250, Math.Min(800, (nextVy - vy) / dt));
+            vx = nextVx; vy = nextVy; lastX = x; lastY = y;
+            int steps = Math.Max(1, (int)Math.Ceiling(dt * 240));
+            double h = dt / steps;
+            for (int i = 0; i < steps; i++)
+            {
+                angularVelocity += (-(900 + ay) / Math.Max(30, length) * Math.Sin(angle)
+                    - ax / Math.Max(30, length) * Math.Cos(angle)
+                    - (2.4 / Math.Sqrt(Math.Max(0.25, mass))) * angularVelocity) * h;
+                angle += angularVelocity * h;
+                if (Math.Abs(angle) > 0.5) { angle = Math.Sign(angle) * 0.5; angularVelocity *= 0.4; }
+            }
+        }
+    }
+}
diff --git a/tools/TestGravity.cs b/tools/TestGravity.cs
new file mode 100644
--- /dev/null
+++ b/tools/TestGravity.cs
@@ -0,0 +1,52 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using Pegline;
+
+class TestGravity
+{
+    static void Check(bool pass, string name) { if (!pass) throw new Exception(name); Console.WriteLine("PASS " + name); }
+    static void Settle(RopePhysics rope, IList<RopeLoad> loads) { for (int i = 0; i < 1200; i++) rope.Step(1.0 / 120, loads); }
+    static void Main()
+    {
+        var empty = new RopePhysics(); Settle(empty, new RopeLoad[0]);
+        Check(Math.Abs(empty.Sample(0.5) - 16) < 0.2, "unloaded string retains shallow sag");
+        var small = new RopePhysics(); var large = new RopePhysics();
+        Settle(small, new[] { new RopeLoad(0.5, RopePhysics.Mass(40, 70)) });
+        Settle(large, new[] { new RopeLoad(0.5, RopePhysics.Mass(145, 110)) });
+        Check(large.Sample(0.5) > small.Sample(0.5) + 8, "larger displayed photo weighs more");
+        Check(large.Sample(0) == 0 && large.Sample(1) == 0, "anchors remain fixed");
+        Check(large.MaxSpeed < 0.1, "stationary load settles without jitter");
+        var left = new RopePhysics(); Settle(left, new[] { new RopeLoad(0.25, 1.5) });
+        Check(left.Sample(0.25) > left.Sample(0.75) + 6, "shape follows load position");
+        var full = new RopePhysics(); var loads = new List<RopeLoad>();
+        for (int i = 0; i < 12; i++) loads.Add(new RopeLoad(0.15 + i * 0.7 / 11, 1.5));
+        Settle(full, loads);
+        Check(full.Sample(0.5) < 110, "full line fits the panel");
+        var t = Stopwatch.StartNew();
+        for (int i = 0; i < 1800; i++)
+        {
+            loads[0] = new RopeLoad(0.5 + Math.Sin(i * 0.15) * 0.42, 1.5);
+            full.Step(i % 80 == 0 ? 0.4 : 1.0 / 60, loads);
+            CheckFinite(full.Sample(0.5));
+        }
+        Console.WriteLine("1800 loaded frames: " + t.ElapsedMilliseconds + " ms");
+        Console.WriteLine("PASS fast dragging and frame stalls remain stable");
+        Settle(full, new RopeLoad[0]);
+        Check(Math.Abs(full.Sample(0.5) - 16) < 0.2, "removing photos releases the weight");
+        var a = new RopePhysics(); var b = new RopePhysics();
+        var one = new[] { new RopeLoad(0.4, 1) };
+        for (int i = 0; i < 60; i++) a.Step(1.0 / 30, one);
+        for (int i = 0; i < 240; i++) b.Step(1.0 / 120, one);
+        Check(Math.Abs(a.Sample(0.4) - b.Sample(0.4)) < 0.1, "30 and 120 Hz agree");
+        var pendulum = new PhotoPendulum();
+        pendulum.Step(1.0 / 60, 100, 40, 65, 1);
+        for (int i = 1; i <= 20; i++) pendulum.Step(1.0 / 60, 100 + i * 5, 40, 65, 1);
+        double before = pendulum.Degrees;
+        pendulum.Step(1.0 / 60, 200, 40, 65, 1);
+        Check(Math.Abs(before) > 1 && Math.Abs(pendulum.Degrees - before) < 8, "release retains pendulum motion");
+        for (int i = 0; i < 900; i++) pendulum.Step(1.0 / 60, 200, 40, 65, 1);
+        Check(Math.Abs(pendulum.Degrees) < 0.01, "photo swing settles");
+    }
+    static void CheckFinite(double value) { if (Double.IsNaN(value) || Double.IsInfinity(value) || Math.Abs(value) > 200) throw new Exception("unstable string"); }
+}
diff --git a/tools/TestGravityView.cs b/tools/TestGravityView.cs
new file mode 100644
--- /dev/null
+++ b/tools/TestGravityView.cs
@@ -0,0 +1,146 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.Serialization;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using Pegline;
+
+// Exercises the real WPF view against generated thumbnails. No clipboard,
+// screenshot watcher, user settings, user files or tray process is touched.
+class TestGravityView
+{
+    static double time;
+    static readonly BindingFlags Fields = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+    static T Field<T>(object owner, string name) { return (T)owner.GetType().GetField(name, Fields).GetValue(owner); }
+    static void Check(bool pass, string name) { if (!pass) throw new Exception(name); Console.WriteLine("PASS " + name); }
+    static Line Fixture(string dir)
+    {
+        // Redirect every persistence path before a UI action can call Save.
+        var settings = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+        typeof(Settings).GetField("Dir", settings).SetValue(null, dir);
+        typeof(Settings).GetField("file", settings).SetValue(null, Path.Combine(dir, "settings.ini"));
+        typeof(Settings).GetField("peggedFile", settings).SetValue(null, Path.Combine(dir, "pegged.txt"));
+        typeof(Settings).GetField("values", settings).SetValue(null, new Dictionary<string, string> { { "soundOff", "1" } });
+        var line = (Line)FormatterServices.GetUninitializedObject(typeof(Line));
+        typeof(Line).GetField("Items", Fields).SetValue(line, new List<Pegged>());
+        typeof(Line).GetField("positionsFile", Fields).SetValue(line, Path.Combine(dir, "positions.tsv"));
+        line.Revealed = true;
+        return line;
+    }
+    static BitmapSource Thumb(int width, int height, Color color)
+    {
+        var visual = new DrawingVisual();
+        using (var dc = visual.RenderOpen())
+        {
+            dc.DrawRectangle(new LinearGradientBrush(color, Color.FromRgb(18, 27, 44), 75), null, new Rect(0, 0, width, height));
+            dc.DrawEllipse(new SolidColorBrush(Color.FromArgb(115, 250, 229, 180)), null, new Point(width * .73, height * .28), height * .16, height * .16);
+            var path = new StreamGeometry();
+            using (var g = path.Open())
+            {
+                g.BeginFigure(new Point(0, height * .75), true, true);
+                g.LineTo(new Point(width * .3, height * .45), true, false);
+                g.LineTo(new Point(width * .65, height * .85), true, false);
+                g.LineTo(new Point(width, height * .5), true, false);
+                g.LineTo(new Point(width, height), true, false);
+                g.LineTo(new Point(0, height), true, false);
+            }
+            dc.DrawGeometry(new SolidColorBrush(Color.FromArgb(185, 24, 34, 46)), null, path);
+        }
+        var bmp = new RenderTargetBitmap(width, height, 96, 96, PixelFormats.Pbgra32);
+        bmp.Render(visual); bmp.Freeze(); return bmp;
+    }
+    static void Advance(LineWindow view, int frames)
+    {
+        var tick = typeof(LineWindow).GetMethod("OnFrame", Fields);
+        for (int i = 0; i < frames; i++)
+        {
+            time += 1.0 / 120;
+            var frame = Activator.CreateInstance(typeof(RenderingEventArgs), Fields, null, new object[] { TimeSpan.FromSeconds(time) }, null);
+            tick.Invoke(view, new object[] { null, frame });
+        }
+        view.UpdateLayout();
+    }
+    static void Save(LineWindow view, string path)
+    {
+        var root = (FrameworkElement)view.Content;
+        var bmp = new RenderTargetBitmap((int)view.Width, (int)view.Height, 96, 96, PixelFormats.Pbgra32);
+        bmp.Render(root);
+        var png = new PngBitmapEncoder(); png.Frames.Add(BitmapFrame.Create(bmp));
+        using (var file = File.Create(path)) png.Save(file);
+    }
+    [STAThread]
+    static void Main(string[] args)
+    {
+        Screens.Init();
+        string dir = Path.GetFullPath(args[0]); Directory.CreateDirectory(dir);
+        var app = new Application { ShutdownMode = ShutdownMode.OnExplicitShutdown };
+        var line = Fixture(dir);
+        line.Items.Add(new Pegged(Path.Combine(dir, "wide.png"), Thumb(480, 125, Color.FromRgb(146, 94, 66))) { RopePosition = .22 });
+        line.Items.Add(new Pegged(Path.Combine(dir, "large.png"), Thumb(420, 320, Color.FromRgb(69, 125, 111))) { RopePosition = .52 });
+        line.Items.Add(new Pegged(Path.Combine(dir, "portrait.png"), Thumb(200, 460, Color.FromRgb(116, 104, 154))) { RopePosition = .79 });
+        foreach (var item in line.Items)
+        {
+            var encoder = new PngBitmapEncoder(); encoder.Frames.Add(BitmapFrame.Create(item.Thumb));
+            using (var file = File.Create(item.Path)) encoder.Save(file);
+        }
+        var view = new LineWindow(line) { Width = 1000, Height = Layout.PanelHeight, Left = -12000, Top = -12000, Topmost = false };
+        view.Show(); view.UpdateLayout(); view.Sync(); Advance(view, 1200);
+        var cards = Field<Dictionary<Guid, CardView>>(view, "cards");
+        var slider = Field<Canvas>(view, "slider");
+        var large = cards[line.Items[1].Id];
+        Check(large.Mass > cards[line.Items[0].Id].Mass * 1.5, "real card proportions produce different loads");
+        foreach (var card in cards.Values)
+        {
+            var clip = card.TransformToAncestor(slider).Transform(new Point(Layout.CardWidth / 2, Layout.PinAbove));
+            Check(Math.Abs(clip.Y - card.RopeY) < .5, "clothespin stays attached to the rope");
+            var frame = Field<Grid>(card, "frameHost");
+            var centre = frame.PointToScreen(new Point(frame.Width / 2, frame.Height / 2));
+            Check(view.PhotoAt(new Native.POINT { X = (int)centre.X, Y = (int)centre.Y }) == card.Item.Id, "rendered card accepts its hit test");
+        }
+        Save(view, Path.Combine(dir, "gravity-before.png"));
+        var start = slider.PointToScreen(new Point(large.X.Value, large.RopeY + 45));
+        view.BeginSlide(large, start);
+        bool followed = true;
+        for (int i = 1; i <= 36; i++)
+        {
+            view.SlideTo(new Point(start.X - i * 5 * Screens.Scale, start.Y)); Advance(view, 1);
+            followed &= Math.Abs(large.X.Value - (520 - i * 5)) < .2;
+        }
+        Check(followed, "drag tracks the pointer without spring lag");
+        double before = ((RotateTransform)large.RenderTransform).Angle;
+        view.EndSlide(true); Advance(view, 1);
+        Check(Math.Abs(((RotateTransform)large.RenderTransform).Angle - before) < 5, "release does not reset the swing");
+        Check(File.ReadAllLines(Path.Combine(dir, "positions.tsv")).Length == 3, "positions persist separately from image files");
+        Save(view, Path.Combine(dir, "gravity-release.png"));
+        Advance(view, 1200); Save(view, Path.Combine(dir, "gravity-after.png"));
+        Check(Math.Abs(large.Item.RopePosition - .34) < .002, "release retains the new location");
+        start = slider.PointToScreen(new Point(large.X.Value, large.RopeY + 45));
+        view.BeginSlide(large, start); view.SlideTo(new Point(start.X + 180 * Screens.Scale, start.Y)); Advance(view, 20);
+        view.EndSlide(false); Advance(view, 600);
+        Check(Math.Abs(large.Item.RopePosition - .34) < .002, "cancel restores the prior location");
+        view.BeginSlide(large, slider.PointToScreen(new Point(large.X.Value, large.RopeY + 45)));
+        view.SlideTo(slider.PointToScreen(new Point(-300, 45))); Advance(view, 1);
+        view.EndSlide(true); Advance(view, 50);
+        var largeFrame = Field<Grid>(large, "frameHost");
+        var bounds = largeFrame.TransformToAncestor(slider).TransformBounds(new Rect(0, 0, largeFrame.Width, largeFrame.Height));
+        Check(bounds.Left >= 0 && bounds.Bottom < view.Height, "edge drag leaves room for swinging photo");
+        large.Item.RopePosition = .52; Advance(view, 1200);
+        if (args.Contains("--interactive"))
+        {
+            view.Title = "Pegline gravity preview";
+            view.Left = 220; view.Top = 180;
+            view.Background = new SolidColorBrush(Color.FromRgb(224, 231, 239));
+            Native.SetExStyle(view.Handle, Native.WS_EX_TOOLWINDOW | Native.WS_EX_NOACTIVATE | Native.WS_EX_TRANSPARENT, false);
+            view.SetClickThrough(false); view.ShowInTaskbar = true;
+            typeof(LineWindow).GetField("lastFrame", Fields).SetValue(view, TimeSpan.Zero);
+            view.Closed += delegate { app.Shutdown(); };
+            app.Run();
+        }
+        else { view.Close(); app.Shutdown(); }
+    }
+}
